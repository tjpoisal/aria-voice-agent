{
  "expo": {
    "name": "Aria",
    "slug": "aria-voice-agent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05060C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.getstackmax.aria",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Aria needs microphone access to listen to your voice.",
        "NSSpeechRecognitionUsageDescription": "Aria uses speech recognition to understand your questions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05060C"
      },
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Aria needs microphone access to listen to your voice."
        }
      ]
    ],
    "scheme": "aria",
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
